# --- ledger ---
DATABASE_URL=postgres://mohar:mohar@localhost:5432/mohar
TSA_URL=https://freetsa.org/tsr        # free RFC 3161 timestamp authority

# --- control-room accounts ---
# Sign-up is open by default so a fresh install can create its first operator.
# Set to false once the real operators exist; existing sessions are unaffected.
ALLOW_SIGNUP=true

# --- sealkeys ---
# No cloud KMS/HSM: share S1 is Argon2id passphrase-wrapped. See ADR 0004.
AUTHORITY_SHARE_KDF=argon2id
ARGON2_MEMORY_KIB=262144
ARGON2_ITERATIONS=3
DRAND_CHAIN_URL=https://api.drand.sh
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
SHAMIR_THRESHOLD=3
SHAMIR_SHARES=4

# --- access ---
ACCESS_GEOFENCE_METRES=150
ACCESS_CLOCK_SKEW_SECONDS=120
ACCESS_SESSION_TTL_SECONDS=90
ANDROID_ATTESTATION_ROOT=./infra/attestation/google-root.pem

# --- webauthn (platform authenticators only, no purchased keys) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Mohar

# --- room-monitor ingest ---
MONITOR_HEARTBEAT_SECONDS=30
MONITOR_MISSED_HEARTBEATS_ALARM=3

# --- control room ---
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
CONTROL_ROOM_ESCALATION_WEBHOOK=
